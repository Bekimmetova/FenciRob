#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include<Servo.h>

ESP8266WebServer server(80);

Servo S1;
Servo S2;
Servo S3;
Servo S4;
Servo S5;

void setup() {
  Serial.begin(115200);
  
  // Hotspot sozlash
  WiFi.softAP("Eco Protect 2", "parol12345", 1, false, 1);
  IPAddress IP = WiFi.softAPIP();
  Serial.print("Hotspot IP manzili: ");
  Serial.println(IP);

  // Server yaratish va endpointlarni sozlash
  server.on("/sendSignal", handleSendSignal);
  server.begin();

  // Pins
  S1.attach(D8);
  S2.attach(D7);
  S3.attach(D6);
  S4.attach(D5);
  S5.attach(D4);

  // Servo boshlanishi
  S1.write(45);
  S2.write(45);
  S3.write(45);
  S4.write(45);
  S5.write(45);
}

void run(int second) {
  // Servolarni boshqarish
  S1.write(90);
  S2.write(90);
  S3.write(90);
  S4.write(90);
  S5.write(90);

  delay(second * 1000);

  // Servolarni boshqarish
  S1.write(45);
  S2.write(45);
  S3.write(45);
  S4.write(45);
  S5.write(45);
}

void loop() {
  // Server so'rovlarini qabul qilish
  server.handleClient();
}

void handleSendSignal() {
  Serial.println("START");

  // Buyruqni qabul qilish va ishga tushirish
  run(2);
  
  Serial.println("Stop");

  // Javobni yuborish
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "text/plain", "OK");
}

